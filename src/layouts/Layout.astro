---
import '../styles/global.css';
import {BASE,REPO,revision,siteRevision,sourceDate,builtAt,latestRun,dateLabel} from '../lib/wiki.mjs';
const {title='고윤정 아카이브',description='고윤정의 작품, 인터뷰, 화보와 활동을 출처와 함께 모은 팬 아카이브.'}=Astro.props;
const canonical=new URL(Astro.url.pathname,Astro.site);
---
<!doctype html><html lang="ko"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="description" content={description}/><meta name="theme-color" content="#183d35"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><link rel="canonical" href={canonical}/><link rel="icon" href={BASE+'favicon.svg'} type="image/svg+xml"/><title>{title==='고윤정 아카이브'?title:title+' · 고윤정 아카이브'}</title></head>
<body><a class="skip" href="#main">본문으로 이동</a><header class="header"><a class="brand" href={BASE}><span class="monogram">G.</span><span>고윤정 아카이브<small>GO YOUN-JUNG ARCHIVE</small></span></a><nav aria-label="주 메뉴"><a href={BASE+'wiki/pages/profile/'}>프로필</a><a href={BASE+'works/'}>작품</a><a href={BASE+'archive/?category=interviews'}>인터뷰</a><a href={BASE+'wiki/pages/schedule/'}>일정</a><a href={BASE+'archive/'}>전체 기록 <span aria-hidden="true">↗</span></a></nav><a class="search-link" href={BASE+'search/'} aria-label="아카이브 검색">⌕ <span>검색</span></a></header><main id="main"><slot/></main>
<footer><div><a class="footer-brand" href={BASE}>GO YOUN-JUNG<br/>ARCHIVE<span>기록은 이어집니다.</span></a><p>공개된 자료와 출처를 모은 비공식 팬 아카이브입니다.<br/>배우 및 소속사가 운영하는 공식 사이트가 아닙니다.</p></div><div class="sync"><strong>기록 동기화</strong><p>원본 변경 <time datetime={sourceDate}>{dateLabel(sourceDate)}</time><br/>사이트 반영 <time datetime={builtAt}>{dateLabel(builtAt)}</time><br/>수집 기록 {latestRun?dateLabel(latestRun.timestamp)+' · '+latestRun.result:'아직 없음'} <span data-freshness data-last-run={latestRun?.timestamp}></span></p><a href={REPO+'/tree/'+revision}>원본 위키 · {revision.slice(0,7)} ↗</a><a href="https://github.com/dkdleljh/goyounjung">홈페이지 소스 ↗</a><a href={BASE+'wiki/sources/photos/'}>사진과 이용 조건 ↗</a></div></footer>
<script>for(const el of document.querySelectorAll('[data-freshness]')){const stamp=(el as HTMLElement).dataset.lastRun;if(stamp&&Date.now()-Date.parse(stamp)>36*3600000)el.textContent='(최근 수집 확인 필요)';}</script>
<script is:inline define:vars={{revision,siteRevision,builtAt,base:BASE}}>
// Check a current receipt on navigation. Refresh once using a versioned URL;
// while someone is reading, offer the update instead of interrupting them.
async function checkLatest(initial=false){
 try{
  const response=await fetch(base+'sync.json?check='+Math.floor(Date.now()/60000),{cache:'no-store',signal:AbortSignal.timeout(8000)});
  if(!response.ok)return;
  const latest=await response.json();
  if(!/^[a-f0-9]{40}$/.test(latest.revision)||!/^[a-f0-9]{40}$/.test(latest.siteRevision))return;
  if(Date.parse(latest.builtAt)<=Date.parse(builtAt)||latest.revision===revision&&latest.siteRevision===siteRevision)return;
  const version=latest.revision.slice(0,12)+'-'+latest.siteRevision.slice(0,12);
  const url=new URL(location.href);url.searchParams.set('v',version);
  if(initial&&new URL(location.href).searchParams.get('v')!==version){location.replace(url.href);return;}
  if(!document.querySelector('#new-records')){
   const notice=document.createElement('aside');notice.id='new-records';notice.setAttribute('aria-live','polite');
   const link=document.createElement('a');link.href=url.href;link.textContent='새 기록이 반영되었습니다. 최신 내용 보기';
   notice.append(link);document.body.append(notice);
  }
 }catch{/* Keep the readable page during network outages. */}
}
checkLatest(true);
setInterval(()=>{if(!document.hidden)checkLatest();},60000);
</script>
</body></html>
