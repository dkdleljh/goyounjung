---
import {workPhoto,renderPhoto} from '../lib/photos.mjs';
import {workUrl} from '../lib/wiki.mjs';
const {work,heading='h2',priority=false}=Astro.props;
const photo=workPhoto(work);
if(!photo)throw new Error(`Missing representative image: ${work.title}`);
const Heading=heading;
---
<article class="work-card" data-platform={work.platform}>
 <Fragment set:html={renderPhoto(photo.id,{href:workUrl(work),compact:true,priority,sizes:'(max-width: 480px) 88vw, (max-width: 760px) 42vw, 300px'})}/>
 <a class="work-caption" href={workUrl(work)}>
  <div><p class="work-year">{work.year} / {work.platform}</p><Heading>{work.title}</Heading><p>{work.role} 역</p><p>{work.status==='released'?'공개 완료':work.status==='reported_once'?'공개 예정 보도':'공개 상태 확인 필요'}{work.note?' · '+work.note:''}</p></div>
  <span aria-hidden="true">↗</span>
 </a>
</article>
