---
import Layout from '../layouts/Layout.astro';
import WorkCard from '../components/WorkCard.astro';
import {works} from '../lib/wiki.mjs';
const sorted=[...works].sort((a,b)=>b.year.localeCompare(a.year));
---
<Layout title="작품"><section class="page-heading"><p class="eyebrow">THE FILMOGRAPHY</p><h1>작품 속의 고윤정</h1><p>서로 다른 세계, 오래 남는 인물들. 위키에 등록된 {works.length}개의 작품입니다.</p></section><section class="section compact"><div class="filter-row" role="group" aria-label="작품 플랫폼 필터"><button class="active" data-filter="all" aria-pressed="true">전체</button>{[...new Set(works.map(w=>w.platform))].map(p=><button data-filter={p} aria-pressed="false">{p}</button>)}</div><p id="work-count" class="subtle" aria-live="polite">{works.length}개의 작품</p><div class="work-grid">{sorted.map((w,i)=><WorkCard work={w} priority={i<4}/>)}</div></section></Layout>
<script>document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach(b=>{b.classList.toggle('active',b===button);b.setAttribute('aria-pressed',String(b===button));});let count=0;document.querySelectorAll<HTMLElement>('[data-platform]').forEach(card=>{card.hidden=button.dataset.filter!=='all'&&card.dataset.platform!==button.dataset.filter;if(!card.hidden)count++;});document.querySelector('#work-count')!.textContent=`${count}개의 작품`;}));</script>
