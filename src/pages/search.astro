---
import Layout from '../layouts/Layout.astro';import {BASE} from '../lib/wiki.mjs';
---
<Layout title="검색"><section class="page-heading"><p class="eyebrow">FIND A STORY</p><h1>어떤 기록을 찾으세요?</h1><p>작품 이름, 배역, 인터뷰 속 단어로 검색해 보세요.</p><form id="search-form" role="search" class="search-form"><label for="query" class="sr-only">검색어</label><input id="query" type="search" name="q" placeholder="예: 무빙, 인터뷰, 차무희" autocomplete="off"/><button type="submit" class="button">검색 ↗</button></form><noscript>검색에는 JavaScript가 필요합니다. <a href={BASE+'archive/'}>전체 기록</a>에서 문서를 찾아보세요.</noscript></section><section class="section compact"><p id="search-state" role="status">검색어를 입력해 주세요.</p><div id="results" class="search-results"></div></section></Layout>
<script>
import {normalize,findResults} from '../lib/search.mjs';
const input=document.querySelector<HTMLInputElement>('#query')!;const state=document.querySelector('#search-state')!;const results=document.querySelector('#results')!;let data:any[]|null=null;let request=0;
async function search(){const ticket=++request;const query=input.value.trim();results.replaceChildren();const url=new URL(location.href);if(query)url.searchParams.set('q',query);else url.searchParams.delete('q');history.replaceState(null,'',url);if(!normalize(query)){state.textContent='검색어를 입력해 주세요.';return;}state.textContent='기록을 찾고 있습니다…';try{if(!data){const response=await fetch(import.meta.env.BASE_URL+'search-index.json');if(!response.ok)throw Error('load');data=await response.json();}if(ticket!==request)return;const found=findResults(data!,query);state.textContent=found.length?`${found.length}개의 기록을 찾았습니다.`:'검색 결과가 없습니다. 다른 단어나 작품 이름을 입력해 보세요.';for(const item of found.slice(0,80)){const a=document.createElement('a');a.href=item.url;const h=document.createElement('h2');h.textContent=item.title;const p=document.createElement('p');const position=normalize(item.text).indexOf(normalize(query));p.textContent=item.text.slice(Math.max(0,position-45),Math.max(0,position-45)+170).replace(/[#*|]/g,' ')+'…';a.append(h,p);results.append(a);}}catch{if(ticket===request)state.textContent='검색 자료를 불러오지 못했습니다. 잠시 후 다시 검색해 주세요.';}}
document.querySelector('#search-form')!.addEventListener('submit',e=>{e.preventDefault();search();});let timer:ReturnType<typeof setTimeout>;input.addEventListener('input',()=>{clearTimeout(timer);timer=setTimeout(search,180);});input.value=new URLSearchParams(location.search).get('q')||'';if(input.value)search();
</script>
