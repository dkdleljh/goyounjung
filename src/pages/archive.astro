---
import Layout from '../layouts/Layout.astro';import {documents,groups,BASE} from '../lib/wiki.mjs';
---
<Layout title="전체 기록"><section class="page-heading"><p class="eyebrow">THE INDEX</p><h1>기록을 펼치다</h1><p>작품부터 출처까지, {documents.length}개의 문서가 이어집니다.</p><a class="text-link" href={BASE+'search/'}>문서 내용으로 검색하기 →</a></section><section class="section compact"><div class="filter-row"><button data-category="all" aria-pressed="true" class="active">전체</button>{groups.map(g=><button data-category={g[0]} aria-pressed="false">{g[1]}</button>)}</div><p class="subtle" id="archive-count" aria-live="polite"></p><div class="document-list">{[...documents].sort((a,b)=>a.group==='news'&&b.group==='news'?b.title.localeCompare(a.title):a.title.localeCompare(b.title,'ko')).map(d=><a href={d.url} data-group={d.group}><span>{groups.find(g=>g[0]===d.group)?.[1]}</span><h2>{d.title}</h2><span aria-hidden="true">↗</span></a>)}</div></section></Layout>
<script>function filter(category:string){const buttons=[...document.querySelectorAll<HTMLButtonElement>('[data-category]')];if(!buttons.some(b=>b.dataset.category===category))category='all';buttons.forEach(b=>{const active=b.dataset.category===category;b.classList.toggle('active',active);b.setAttribute('aria-pressed',String(active));});let count=0;document.querySelectorAll<HTMLElement>('[data-group]').forEach(d=>{d.hidden=category!=='all'&&d.dataset.group!==category;if(!d.hidden)count++;});document.querySelector('#archive-count')!.textContent=`${count}개의 기록`;};filter(new URLSearchParams(location.search).get('category')||'all');document.querySelectorAll<HTMLButtonElement>('[data-category]').forEach(b=>b.addEventListener('click',()=>{const url=new URL(location.href);url.searchParams.set('category',b.dataset.category!);history.replaceState(null,'',url);filter(b.dataset.category!);}));</script>
